# live | demo | auto   (auto = try live APIs, fall back to simulated data if unreachable)
DATA_MODE=auto
PORT=8787

# Chains tracked by the memescope. Keys map to GeckoTerminal network ids in server/src/config.ts
MEME_CHAINS=solana,base,robinhood,bsc,hyperevm

# Override GeckoTerminal network ids if they change (e.g. once Robinhood Chain is listed)
# GT_NETWORK_ROBINHOOD=robinhood
# GT_NETWORK_HYPEREVM=hyperevm

# Rolling window used for trader ROI
ROI_WINDOW_DAYS=60

# Alert delivery (all optional — the web UI always gets alerts over SSE)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
