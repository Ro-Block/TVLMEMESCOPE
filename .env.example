# Copy this file to .env. The .env file stays on your PC: it is in .gitignore and never pushed.

# live | demo | auto   (auto = try live APIs, fall back to simulated data if unreachable)
DATA_MODE=live
PORT=8787

# Chains tracked by the memescope
MEME_CHAINS=solana,base,robinhood,bsc,hyperevm

# --- Solana trades (wallets, snipers, whales) ---
# Free key from https://dashboard.helius.dev (free plan: 1M credits/month)
HELIUS_API_KEY=
# Daily spend cap; 30000/day stays inside the free plan
HELIUS_DAILY_CREDITS=30000

# --- EVM chains: public RPCs (swap events read straight from the chain). Replace if one is slow. ---
# RPC_BASE=https://base-rpc.publicnode.com
# RPC_BSC=https://bsc-rpc.publicnode.com
# RPC_HYPEREVM=https://rpc.hyperliquid.xyz/evm
# RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_WETH=            # WETH address on Robinhood Chain, if you know it (native ETH pools work without)

# When a new token shows up in the memescope (DexScreener stats, last hour)
PROMOTE_MIN_TXNS_H1=25
PROMOTE_MIN_VOLUME_H1=3000
PROMOTE_MIN_LIQUIDITY=5000

# --- Optional wallet names (funds, exchanges, KOLs) ---
ARKHAM_API_KEY=
# ARKHAM_HOURLY_LOOKUPS=150

# Rolling window used for trader ROI
ROI_WINDOW_DAYS=60

# GeckoTerminal is off by default; set to on to use its pool stats for the map's 5m/1h/6h volume
# GECKOTERMINAL_POOLS=off

# Alert delivery (all optional — the web UI always gets alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
